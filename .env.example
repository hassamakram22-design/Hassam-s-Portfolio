# Copy this file to ".env" and fill in your key. Never commit .env.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here# Any model id from https://openrouter.ai/models
# Cheap and reliable default; you can also try a ":free" model listed on OpenRouter.
OPENROUTER_MODEL=openai/gpt-4o-mini

SITE_URL=http://127.0.0.1:5000
SITE_NAME=Hassam Akram Portfolio
PORT=5000
